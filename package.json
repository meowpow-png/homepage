{
  "name": "homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.js",
    "clean": "rm -rf node_modules package-lock.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default",
    "test:build": "vitest run --config vitest.build.config.ts --reporter=default",
    "test:e2e": "playwright test",
    "generate:og-image": "node scripts/generate-og-image.js",
    "generate:diagram-svgs": "node scripts/generate-diagram-svg.js",
    "lighthouse": "rm -rf .lighthouseci && npm run build && lhci autorun && npm run lighthouse:index",
    "lighthouse:index": "node scripts/generate-lh-index.js",
    "test:coverage:merge": "node tests/merge-coverage.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint '**/*.css'",
    "lint": "run-s --continue-on-error lint:eslint lint:stylelint",
    "lint:fix:eslint": "eslint . --fix",
    "lint:fix:stylelint": "stylelint '**/*.css' --fix",
    "lint:fix": "run-s --continue-on-error lint:fix:eslint lint:fix:stylelint",
    "typecheck": "tsc -b",
    "knip": "knip",
    "qualitycheck": "run-s --continue-on-error format:check lint typecheck build test:build knip",
    "verify": "run-s --continue-on-error format:check lint typecheck build test:build test:coverage knip"
  },
  "dependencies": {
    "@catppuccin/palette": "^1.8.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-pretty-code": "^0.14.4",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.3",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-istanbul": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.8.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "mermaid": "^11.16.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
